    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
