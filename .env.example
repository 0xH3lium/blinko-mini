# Server
PORT=3000
NODE_ENV=development
DB_PATH=./data/app.db

# Telegram Auth & Single-User Lock (REQUIRED)
BOT_TOKEN=123456:ABC-DEF...
OWNER_TELEGRAM_ID=123456789

# Bot Transport Mode: "polling" (default) or "webhook"
BOT_MODE=polling

# Required ONLY when BOT_MODE=webhook
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=random_secret_string_for_tg_header

# Optional local-browser convenience. Never use in production.
# DEV_AUTH_BYPASS=true
