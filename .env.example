# Blinko-OS runtime
PORT=3000
NODE_ENV=development
DB_PATH=./data/app.db
PUBLIC_URL=http://localhost:3000
OWNER_TIMEZONE=Asia/Tehran

# Telegram Bot (single-owner lock)
BOT_TOKEN=123456:ABC-DEF...
OWNER_TELEGRAM_ID=123456789
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=


# PC panel session signing (auto-generated in dev; required in production)
SESSION_SECRET=change_me_to_32_plus_random_bytes

# Optional local dev convenience only (rejected in production)
# DEV_AUTH_BYPASS=false
